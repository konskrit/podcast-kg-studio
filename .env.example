# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-hex-32
# Set true only behind a trusted reverse proxy in production.
# AUTH_TRUST_HOST=true
# AUTH_URL=http://localhost:3000

# Postgres (Compose defaults or local install)
POSTGRES_USER=pkg
POSTGRES_PASSWORD=pkg
POSTGRES_DB=podcast_kg_studio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pkg:pkg@localhost:5432/podcast_kg_studio?schema=public

# Oxigraph (Compose binds to 127.0.0.1; or native oxigraph serve)
OXIGRAPH_PORT=7878
OXIGRAPH_URL=http://127.0.0.1:7878

# Local file storage (uploads + audio)
DATA_DIR=./data/app

# Settings encryption (32-byte key, base64). Generate later in slice 1.
# SETTINGS_ENCRYPTION_KEY=
